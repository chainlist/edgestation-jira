{
  "$schema": "./node_modules/@edgestation/sdk/manifest.schema.json",
  "name": "Jira board",
  "version": "1.1.0",
  "description": "The active sprint of a Jira board, column by column. Drag a card to another column to move the issue, or tap it to read the issue. For Jira Cloud and Jira Data Center.",
  "author": "ChainList",
  "minAppVersion": "0.5.0",
  "main": "dist/main.js",
  "icon": "icon.svg",
  "size": {
    "w": 4,
    "h": 2
  },
  "permissions": [
    "fetch"
  ],
  "settings": [
    {
      "key": "board",
      "label": "Board address",
      "type": "text",
      "placeholder": "https://your-site.atlassian.net/jira/software/projects/KEY/boards/1"
    },
    {
      "key": "email",
      "label": "Email (Jira Cloud only)",
      "type": "text",
      "placeholder": "you@example.com"
    },
    {
      "key": "token",
      "label": "API token or personal access token",
      "type": "text",
      "secret": true
    }
  ]
}
